From d3e05a45289c5e3ad123ad47e8d798c49742aa70 Mon Sep 17 00:00:00 2001
From: XinYueNeko <3649745663@qq.com>
Date: Thu, 24 Sep 2026 21:30:59 +0800
Subject: [PATCH] Fix-Some


diff --git a/src/main/resources/log4j2.xml b/src/main/resources/log4j2.xml
index c99aedb40..02b6bd4d6 100644
--- a/src/main/resources/log4j2.xml
+++ b/src/main/resources/log4j2.xml
@@ -3,10 +3,10 @@
     <Appenders>
         <Console name="WINDOWS_COMPAT" target="SYSTEM_OUT"></Console>
         <Queue name="TerminalConsole">
-            <PatternLayout pattern="[%d{HH:mm:ss} %level]: %msg{nolookups}%n" />
+            <PatternLayout pattern="[%d{HH:mm:ss} BLUE/%level] %msg{nolookups}%n" />
         </Queue>
         <RollingRandomAccessFile name="File" fileName="logs/latest.log" filePattern="logs/%d{yyyy-MM-dd}-%i.log.gz">
-            <PatternLayout pattern="[%d{HH:mm:ss}] [%t/%level]: %msg{nolookups}%n" />
+            <PatternLayout pattern="[Blue] [%d{HH:mm:ss}] [%t/%level]: %msg{nolookups}%n" />
             <Policies>
                 <TimeBasedTriggeringPolicy />
                 <OnStartupTriggeringPolicy />
-- 
